# video-edit skill — API keys
# Copy this file to `.env` (same folder) and fill in the values you have.
# render.sh auto-sources `.env`, so child scripts inherit these.
# All three are OPTIONAL — the core render pipeline works without any of them.

# Optional: enables the LLM transcript-polish step (polish_transcript.py).
ANTHROPIC_API_KEY=

# Optional: enables Pexels stock-photo/video b-roll fetch (fetch_stock.py).
# Free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional: only referenced by zoom_plan.py's OpenAI codepath.
OPENAI_API_KEY=
